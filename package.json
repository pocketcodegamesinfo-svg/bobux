{
  "name": "bobux",
  "version": "0.1.0",
  "description": "Игровая платформа Bobux",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}